<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#141418">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"
        android:text="DEX / HOME ONLY" android:textColor="#FF4655" android:textStyle="bold" android:textSize="16sp" />
    <TextView android:id="@+id/widget_collection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Next" />
        <Button android:id="@+id/widget_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Pause" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_album" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Album" />
        <Button android:id="@+id/widget_select" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Select" />
    </LinearLayout>
</LinearLayout>
